#!/usr/bin/env python3
"""Refresh the production image pins from published upstream releases."""

import argparse
import json
from pathlib import Path
import re
import sys
from urllib.error import HTTPError
from urllib.request import Request, urlopen


def fetch(url):
    request = Request(url, headers={"User-Agent": "hamster-travel-image-updater"})
    with urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8")


def latest_release(repo, prefix):
    release = json.loads(fetch(f"https://api.github.com/repos/{repo}/releases/latest"))
    tag = release["tag_name"]
    if release["prerelease"] or not re.fullmatch(rf"{prefix}\d+(?:\.\d+){{1,3}}", tag):
        raise ValueError(f"Unexpected stable release tag for {repo}: {tag}")
    return tag.removeprefix(prefix)


def require_image(repo, tag):
    try:
        metadata = json.loads(fetch(f"https://hub.docker.com/v2/repositories/{repo}/tags/{tag}/"))
    except HTTPError as error:
        if error.code == 404:
            raise ValueError(f"Waiting for Docker Hub to publish {repo}:{tag}") from error
        raise
    if not any(
        image["os"] == "linux" and image["architecture"] == "amd64"
        for image in metadata["images"]
    ):
        raise ValueError(f"No linux/amd64 image published for {repo}:{tag}")


def pin(dockerfile, name, pattern):
    matches = re.findall(rf"^ARG {name}=({pattern})$", dockerfile, re.MULTILINE)
    if len(matches) != 1:
        raise ValueError(f"Expected one valid {name} pin in Dockerfile")
    return matches[0]


def refresh(dockerfile):
    version_pattern = r"\d+(?:\.\d+){1,3}"
    previous_elixir = pin(dockerfile, "ELIXIR_VERSION", version_pattern)
    previous_otp = pin(dockerfile, "OTP_VERSION", version_pattern)
    previous_debian = pin(dockerfile, "DEBIAN_VERSION", r"[a-z]+-\d{8}-slim")
    codename, previous_snapshot, _ = previous_debian.split("-")
    node_image = pin(dockerfile, "NODE_IMAGE", rf'"node:\d+-{codename}-slim"')
    node_tag = node_image.removeprefix('"node:').removesuffix('"')

    elixir = latest_release("elixir-lang/elixir", "v")
    otp = latest_release("erlang/otp", "OTP-")
    library = fetch("https://raw.githubusercontent.com/docker-library/official-images/master/library/debian")
    snapshots = re.findall(rf"\b{codename}-(\d{{8}})-slim\b", library)
    if not snapshots:
        raise ValueError(f"No Debian slim snapshots listed for {codename}")
    snapshot = max(snapshots)
    debian = f"{codename}-{snapshot}-slim"

    for previous, latest in [(previous_elixir, elixir), (previous_otp, otp)]:
        if tuple(map(int, latest.split("."))) < tuple(map(int, previous.split("."))):
            raise ValueError(f"Refusing to downgrade {previous} to {latest}")
    if snapshot < previous_snapshot:
        raise ValueError(f"Refusing to downgrade {previous_debian} to {debian}")

    require_image("hexpm/elixir", f"{elixir}-erlang-{otp}-debian-{debian}")
    require_image("library/debian", debian)
    require_image("library/node", node_tag)

    print(f"Verified Elixir {elixir}, Erlang/OTP {otp}, and Debian {debian}", flush=True)
    for name, version in [
        ("ELIXIR_VERSION", elixir),
        ("OTP_VERSION", otp),
        ("DEBIAN_VERSION", debian),
    ]:
        dockerfile = re.sub(rf"^ARG {name}=.*$", f"ARG {name}={version}", dockerfile, flags=re.MULTILINE)
    return dockerfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="verify pins without editing Dockerfile")
    args = parser.parse_args()

    dockerfile = Path("Dockerfile")
    original = dockerfile.read_text()
    updated = refresh(original)
    if updated == original:
        print("Dockerfile is current.")
        return
    if args.check:
        sys.exit("Dockerfile has newer pins available.")
    dockerfile.write_text(updated)
    print("Updated Dockerfile.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        sys.exit(str(error))
