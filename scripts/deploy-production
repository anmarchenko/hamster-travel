#!/usr/bin/env sh
set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "${repo_root}"

if [ ! -f .kamal/secrets.production ]; then
  echo "Missing .kamal/secrets.production; copy .kamal/secrets.example and configure its sources." >&2
  exit 1
fi

registry_server="${KAMAL_REGISTRY_SERVER:-127.0.0.1:5555}"
registry_container="kamal-docker-registry"
deployment_version="${KAMAL_VERSION:-local-$(date -u +%Y%m%d%H%M%S)}"
previous_container=""
restore_previous="false"

cleanup_registry() {
  if [ "${registry_server}" = "127.0.0.1:5555" ]; then
    docker rm --force "${registry_container}" >/dev/null 2>&1 || true
  fi
}

cleanup() {
  status="$?"
  trap - EXIT

  if [ "${status}" -ne 0 ] && [ "${restore_previous}" = "true" ]; then
    echo "Deployment failed; restarting previous container ${previous_container}." >&2
    docker start "${previous_container}" >/dev/null || true
  fi

  cleanup_registry
  exit "${status}"
}

if [ "${registry_server}" = "127.0.0.1:5555" ]; then
  cleanup_registry
  docker run --detach --publish 127.0.0.1:5555:5000 --name "${registry_container}" registry:3 >/dev/null
fi

trap cleanup EXIT

# Build while the current release is still serving. With direct loopback port
# publishing and no kamal-proxy, the old container must release the port before
# the new one can boot.
kamal build push --destination production --version "${deployment_version}"

previous_container="$(
  docker ps \
    --filter label=service=hamster-travel \
    --filter label=destination=production \
    --filter label=role=web \
    --format '{{.Names}}' | head -n 1
)"

if [ -n "${previous_container}" ]; then
  docker stop --timeout 30 "${previous_container}" >/dev/null
  restore_previous="true"
fi

kamal deploy --destination production --skip-push --version "${deployment_version}" "$@"
restore_previous="false"
kamal migrate --destination production
kamal verify-storage --destination production
