#!/usr/bin/env bash
set -euo pipefail

role="${1:?expected db or infra credential scope}"
shift
case "$role" in
  db|infra) ;;
  *) printf 'Unknown production credential scope.\n' >&2; exit 2 ;;
esac

if [[ ! -f /etc/hamster-travel/credentials/op.json ]]; then
  printf 'Production 1Password references are missing. See the credential recovery runbook.\n' >&2
  exit 1
fi

if (( EUID == 0 )); then
  exec /usr/local/libexec/hamster-production-credentials run "$role" "$@"
fi
exec /usr/bin/pkexec --keep-cwd /usr/bin/python3 /usr/local/libexec/hamster-production-credentials run "$role" "$@"
