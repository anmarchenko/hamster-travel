#!/usr/bin/env bash
set -euo pipefail

role="${1:?expected db or infra credential scope}"
shift
case "$role" in
  db|infra) ;;
  *) printf 'Unknown production credential scope.\n' >&2; exit 2 ;;
esac

store=/etc/hamster-travel/credentials
manifest="$store/$role.toml"
if [[ ! -f "$manifest" ]]; then
  exec "$@"
fi

runtime="${RUNTIME_DIRECTORY:-/run/user/$(id -u)}"
if [[ "$(stat -f -c %T -- "$runtime")" != tmpfs ]]; then
  printf 'Production credentials require a tmpfs runtime directory.\n' >&2
  exit 1
fi

umask 077
work="$(mktemp -d "$runtime/hamster-credentials.XXXXXXXX")"
trap 'rm -rf -- "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

identity="${CREDENTIALS_DIRECTORY:+$CREDENTIALS_DIRECTORY/age-identity}"
if [[ -z "$identity" ]]; then
  identity="$work/age-identity"
  /usr/bin/systemd-creds --user --no-ask-password --name=age-identity decrypt \
    "$store/$role-user.cred" - > "$identity"
fi

materialize() {
  env -i PATH=/usr/bin FNOX_CONFIG_DIR=/nonexistent FNOX_AGE_KEY_FILE="$identity" \
    /usr/local/bin/fnox -c "$manifest" --no-daemon --non-interactive --if-missing error get "$1" \
    | base64 --decode > "$2"
  [[ -s "$2" ]]
}

materialize BACKUP_ENV "$work/backup.env"
export HAMSTER_TRAVEL_PRODUCTION_ENV_FILE="$work/backup.env"
if [[ "$role" == infra && -z "${HAMSTER_TRAVEL_INFRA_RESTIC_PASSWORD_FILE:-}" ]]; then
  materialize RESTIC_PASSWORD_FILE "$work/restic-password"
  export HAMSTER_TRAVEL_INFRA_RESTIC_PASSWORD_FILE="$work/restic-password"
  export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-$work/restic-password}"
fi

"$@"
