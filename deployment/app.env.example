# Install as /home/marvin/Work/hamster-travel-production/app.env with mode 0600.
# This file is passed to the application containers, so do not add backup-only
# AWS credentials or unrelated host environment variables.
DATABASE_URL=ecto://hamster_travel:REPLACE_ME@postgres/hamster_travel
SECRET_KEY_BASE=REPLACE_ME
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
OPEN_EXCHANGE_RATES_APP_ID=REPLACE_ME
MAPBOX_ACCESS_TOKEN=REPLACE_ME
