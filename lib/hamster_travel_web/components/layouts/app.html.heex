<header class="dark:border-b dark:border-zinc-800">
  <.navbar
    current_user={assigns[:current_user]}
    active_nav={assigns[:active_nav]}
    active_tab={assigns[:active_tab]}
    mobile_menu={assigns[:mobile_menu]}
    return_to={assigns[:return_to]}
    trip_slug={assigns[:trip_slug]}
  />
</header>

<.flash_group flash={@flash} />

<main
  id="offline-read-only-root"
  phx-hook="OfflineReadOnly"
  class="pb-16 sm:pb-0 text-zinc-600 dark:text-zinc-300"
  data-offline-lock={if assigns[:offline_local_tabs], do: nil, else: true}
>
  {@inner_content}
</main>
